<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para consultar el tipo de cambio por internet -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumiFinanzas">

        <!-- NUEVA PANTALLA DE BIENVENIDA -->
        <!-- Se mostrará al abrir LumiFinanzas -->
        <activity
            android:name=".BienvenidaActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- PANTALLA PRINCIPAL -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- PANTALLA DEL HISTORIAL -->
        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- PANTALLA DE ESTADÍSTICAS -->
        <activity
            android:name=".EstadisticasActivity"
            android:exported="false" />

        <!-- PANTALLA DE METAS DE AHORRO -->
        <activity
            android:name=".MetasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- PANTALLA LUMI CAMBIO -->
        <activity
            android:name=".CambioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
