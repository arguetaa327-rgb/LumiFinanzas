<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F6FD">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_wallet"
                    android:contentDescription="LumiFinanzas" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="LumiFinanzas"
                    android:textColor="#5834A6"
                    android:textSize="27sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tu dinero, tus metas"
                android:textColor="#777083"
                android:textSize="14sp" />

            <!-- SALDO TOTAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_saldo_lumi"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SALDO TOTAL"
                    android:textColor="#EDE5FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtSaldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Q 0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tu resumen financiero"
                    android:textColor="#EDE5FF"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- AHORRO Y DINERO DISPONIBLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_lavanda_lumi"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_savings"
                        android:contentDescription="Ahorro" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ahorro"
                        android:textColor="#5834A6"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAhorroReservado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="#5834A6"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reservado"
                        android:textColor="#77649A"
                        android:textSize="11sp" />

                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_blanco_lumi"
                    android:orientation="vertical"
                    android:padding="15dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_wallet"
                        app:tint="#176B45"
                        android:contentDescription="Disponible" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Disponible"
                        android:textColor="#176B45"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDineroDisponible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Q 0.00"
                        android:textColor="#176B45"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Para gastar"
                        android:textColor="#6B8375"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/txtAvisoDisponible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tus ahorros se mantienen separados de tus gastos."
                android:textColor="#777083"
                android:textSize="12sp" />

            <!-- RESUMEN FINANCIERO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Mi resumen"
                android:textColor="#30244D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <!-- INGRESOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_blanco_lumi"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_ingresos"
                        app:tint="#176B45"
                        android:contentDescription="Ingresos" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ingresos"
                        android:textColor="#176B45"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtIngresos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Q 0.00"
                        android:textColor="#176B45"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- GASTOS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_blanco_lumi"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_gastos"
                        app:tint="#AE244C"
                        android:contentDescription="Gastos" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Gastos"
                        android:textColor="#AE244C"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtGastos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Q 0.00"
                        android:textColor="#AE244C"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- PRESUPUESTO MENSUAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_blanco_lumi"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_presupuesto"
                        android:contentDescription="Presupuesto" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Mi presupuesto"
                        android:textColor="#30244D"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMesPresupuesto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mes actual"
                        android:textColor="#6741B8"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="PRESUPUESTO MENSUAL"
                    android:textColor="#777083"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txtPresupuesto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Sin configurar"
                    android:textColor="#5834A6"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <!-- GASTADO -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_presupuesto_gastado"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gastado este mes"
                            android:textColor="#765A64"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtGastadoMes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Q 0.00"
                            android:textColor="#AE244C"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <!-- DISPONIBLE -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/fondo_presupuesto_disponible"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Disponible"
                            android:textColor="#4E7460"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtDisponiblePresupuesto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Q 0.00"
                            android:textColor="#176B45"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Progreso del presupuesto"
                    android:textColor="#625B73"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/progresoPresupuesto"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#6741B8"
                    android:progressBackgroundTint="#EDE5FB" />

                <TextView
                    android:id="@+id/txtAlertaPresupuesto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Establece un límite para controlar tus gastos."
                    android:textColor="#6741B8"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnConfigurarPresupuesto"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#6741B8"
                    android:text="Configurar presupuesto"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LUMI CAMBIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_cambio_inicio"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_cambio"
                        app:tint="#FFFFFF"
                        android:contentDescription="Lumi Cambio" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Lumi Cambio"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USD / GTQ"
                        android:textColor="#E9E8FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tu dinero, sin fronteras"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Convierte dólares y quetzales con el tipo de cambio de referencia del Banco de Guatemala."
                    android:textColor="#E9E8FF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="43dp"
                        android:background="@drawable/fondo_lavanda_lumi"
                        android:gravity="center"
                        android:text="USD"
                        android:textColor="#39439B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="43dp"
                        android:gravity="center"
                        android:text="↔"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="76dp"
                        android:layout_height="43dp"
                        android:background="@drawable/fondo_lavanda_lumi"
                        android:gravity="center"
                        android:text="GTQ"
                        android:textColor="#39439B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnAbrirCambio"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Abrir Lumi Cambio"
                    android:textAllCaps="false"
                    android:textColor="#39439B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- NUEVO MOVIMIENTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/fondo_registro_inicio"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/fondo_blanco_lumi"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#6741B8"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nuevo movimiento"
                            android:textColor="#30244D"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Registra tus ingresos y gastos"
                            android:textColor="#625B73"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnAgregarMovimiento"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#6741B8"
                    android:text="+ Registrar movimiento"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ACTIVIDAD RECIENTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Actividad reciente"
                        android:textColor="#30244D"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Tus últimos movimientos financieros"
                        android:textColor="#777083"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_historial"
                    app:tint="#6741B8"
                    android:contentDescription="Historial" />

            </LinearLayout>

            <!-- CONTENEDOR DINÁMICO DE TARJETAS -->
            <LinearLayout
                android:id="@+id/contenedorMovimientosRecientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnVerHistorial"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#EDE5FB"
                android:text="Explorar historial completo"
                android:textAllCaps="false"
                android:textColor="#6741B8"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVerEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#6741B8"
                android:text="Ver estadísticas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- NAVEGACIÓN INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:drawableTop="@drawable/ic_inicio"
            android:drawablePadding="4dp"
            android:text="Inicio"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textColor="#6741B8"
            android:backgroundTint="#EDE5FB" />

        <Button
            android:id="@+id/navHistorial"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:drawableTop="@drawable/ic_historial"
            android:drawablePadding="4dp"
            android:text="Historial"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textColor="#625B73"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/navEstadisticas"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1.25"
            android:layout_margin="2dp"
            android:drawableTop="@drawable/ic_estadisticas"
            android:drawablePadding="4dp"
            android:text="Estadísticas"
            android:textAllCaps="false"
            android:textSize="10sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textColor="#625B73"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/navMetas"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:drawableTop="@drawable/ic_metas"
            android:drawablePadding="4dp"
            android:text="Metas"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:textColor="#625B73"
            android:backgroundTint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
