<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nuevo movimiento"
                    android:textColor="#30244D"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Organiza tu dinero fácilmente"
                    android:textColor="#777083"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCerrarMovimiento"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/fondo_cerrar_movimiento"
                android:clickable="true"
                android:contentDescription="Cerrar formulario"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="#6741B8"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- INGRESO O GASTO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="¿Qué deseas registrar?"
            android:textColor="#30244D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioTipoMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioIngreso"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/fondo_presupuesto_disponible"
                android:button="@null"
                android:gravity="center"
                android:text="↗&#10;Ingreso"
                android:textColor="#176B45"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/radioGasto"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:background="@drawable/fondo_presupuesto_gastado"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="↘&#10;Gasto"
                android:textColor="#AE244C"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- MONEDA Y CANTIDAD EN DOS COLUMNAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- COLUMNA MONEDA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Moneda"
                    android:textColor="#30244D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerMonedaMovimiento"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fondo_registro_inicio"
                    android:paddingStart="8dp"
                    android:paddingEnd="5dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <!-- COLUMNA CANTIDAD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cantidad"
                    android:textColor="#30244D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fondo_registro_inicio"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/txtSimboloMonedaMovimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Q"
                        android:textColor="#6741B8"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtMonto"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:textColor="#30244D"
                        android:textColorHint="#9A94A6"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- TARJETA DE CONVERSIÓN -->
        <LinearLayout
            android:id="@+id/tarjetaConversionMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:background="@drawable/fondo_registro_inicio"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equivalente en quetzales"
                android:textColor="#30244D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEquivalenteMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Q 0.00"
                android:textColor="#6741B8"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleConversionMovimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tipo de cambio del Banco de Guatemala"
                android:textColor="#625B73"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#EDE5FB"
                android:padding="10dp"
                android:text="El monto se guardará en quetzales para calcular tu saldo, presupuesto y ahorros."
                android:textColor="#625B73"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- DESCRIPCIÓN: SE CONSERVA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="Descripción"
            android:textColor="#30244D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_registro_inicio"
            android:hint="¿En qué utilizaste tu dinero?"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:padding="14dp"
            android:textColor="#30244D"
            android:textColorHint="#9A94A6"
            android:textSize="14sp" />

        <!-- CATEGORÍAS: SE CONSERVAN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="Selecciona una categoría"
            android:textColor="#30244D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/contenedorCategoriasMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="4"
            android:rowCount="2" />

        <Spinner
            android:id="@+id/spinnerCategoria"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <!-- MENSAJE DE AHORROS -->
        <TextView
            android:id="@+id/txtAyudaMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="Tus gastos se descontarán del dinero disponible, sin utilizar tus ahorros reservados."
            android:textColor="#AE244C"
            android:textSize="12sp" />

        <!-- BOTÓN GUARDAR -->
        <Button
            android:id="@+id/btnGuardarMovimiento"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#6741B8"
            android:text="Guardar gasto"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- PIE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="LumiFinanzas · Tu dinero bajo control"
            android:textColor="#9A94A6"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
