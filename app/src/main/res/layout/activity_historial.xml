<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6FD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/ic_historial"
                app:tint="#6741B8"
                android:contentDescription="Historial" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Mi historial"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#5834A6" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Consulta tus ingresos y gastos registrados."
            android:textSize="14sp"
            android:textColor="#625B73" />

        <!-- TARJETAS DE RESUMEN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <!-- INGRESOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/fondo_blanco_lumi"
                android:orientation="vertical"
                android:padding="15dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_ingresos"
                    app:tint="#176B45"
                    android:contentDescription="Ingresos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Total de ingresos"
                    android:textColor="#625B73"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtIngresosHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Q 0.00"
                    android:textColor="#176B45"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <!-- GASTOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/fondo_blanco_lumi"
                android:orientation="vertical"
                android:padding="15dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_gastos"
                    app:tint="#AE244C"
                    android:contentDescription="Gastos" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Total de gastos"
                    android:textColor="#625B73"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtGastosHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Q 0.00"
                    android:textColor="#AE244C"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- TÍTULO DE MOVIMIENTOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mis movimientos"
            android:textColor="#30244D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTotalMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Movimientos registrados: 0"
            android:textColor="#777083"
            android:textSize="13sp" />

        <!-- FILTROS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFiltroTodos"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Todos"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6741B8" />

            <Button
                android:id="@+id/btnFiltroIngresos"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Ingresos"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#6741B8"
                android:backgroundTint="#EDE5FB" />

            <Button
                android:id="@+id/btnFiltroGastos"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Gastos"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#6741B8"
                android:backgroundTint="#EDE5FB" />

        </LinearLayout>

        <!-- CONTENEDOR DE MOVIMIENTOS -->
        <LinearLayout
            android:id="@+id/contenedorMovimientos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />

        <!-- VOLVER AL INICIO -->
        <Button
            android:id="@+id/btnVolverInicio"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6741B8" />

    </LinearLayout>
</ScrollView>
