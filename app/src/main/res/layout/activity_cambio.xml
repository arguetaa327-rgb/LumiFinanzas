<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F9F5"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="30dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_cambio"
                android:tint="#176B45"
                android:contentDescription="Lumi Cambio" />

            <TextView
                android:id="@+id/txtTituloCambio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Lumi Cambio"
                android:textColor="#176B45"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tu conversor de dólares y quetzales"
            android:textColor="#64796D"
            android:textSize="14sp" />

        <!-- TARJETA VERDE DE TIPO DE CAMBIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_verde_cambio"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TIPO DE CAMBIO OFICIAL"
                    android:textColor="#D5F3E1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_wallet"
                    android:tint="#D5F3E1"
                    android:contentDescription="Tipo de cambio" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTasaCambio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Consultando..."
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaCambio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Esperando información"
                android:textColor="#D5F3E1"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Banco de Guatemala"
                android:textColor="#D5F3E1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CONVERSOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_blanco_lumi"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Convertir moneda"
                android:textColor="#203F30"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- TIPO DE CONVERSIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tipo de conversión"
                android:textColor="#64796D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerConversion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/fondo_menta_cambio"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- CANTIDAD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Cantidad a convertir"
                android:textColor="#203F30"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtCantidadCambio"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/fondo_menta_cambio"
                android:hint="Ejemplo: 100.00"
                android:inputType="numberDecimal"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#203F30"
                android:textColorHint="#83998B"
                android:textSize="18sp" />

            <!-- RESULTADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/fondo_menta_cambio"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="RESULTADO DE CONVERSIÓN"
                    android:textColor="#176B45"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtResultadoCambio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Ingresa una cantidad para convertir"
                    android:textColor="#176B45"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- BOTÓN CONVERTIR -->
            <Button
                android:id="@+id/btnConvertir"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#176B45"
                android:text="Convertir"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ACTUALIZAR TASA -->
        <Button
            android:id="@+id/btnActualizarCambio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#E0F2E8"
            android:text="Actualizar tipo de cambio"
            android:textAllCaps="false"
            android:textColor="#176B45"
            android:textSize="14sp" />

        <!-- ESTADO DE LA CONEXIÓN -->
        <TextView
            android:id="@+id/txtEstadoCambio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Preparando conexión..."
            android:textColor="#64796D"
            android:textSize="12sp" />

        <!-- FUENTE OFICIAL -->
        <TextView
            android:id="@+id/txtFuenteCambio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Fuente: Banco de Guatemala (Banguat)"
            android:textColor="#176B45"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tipo de cambio de referencia. Las tasas de los bancos pueden variar."
            android:textColor="#64796D"
            android:textSize="11sp" />

        <!-- REGRESAR AL INICIO -->
        <Button
            android:id="@+id/btnVolverCambio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#203F30"
            android:text="Volver al inicio"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
